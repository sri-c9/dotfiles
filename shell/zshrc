export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Default is too faint on a transparent background.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#6e6e6e"

# Guarded: a missing ~/.oh-my-zsh would otherwise abort the rest of this file
# (PATH, the .zshenv.local source) on a fresh machine.
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "zshrc: ~/.oh-my-zsh missing - run ~/Developer/config/dotfiles/install.sh"
fi

# Shell options
setopt autocd              # cd by typing directory name
setopt correct             # autocorrect small typos
setopt interactivecomments # allow comments in interactive shell
setopt noclobber           # prevent overwriting files with >

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups       # ignore duplicate commands
setopt hist_ignore_space      # commands starting with space aren't saved
setopt hist_expire_dups_first # expire duplicates first when trimming
setopt extended_history       # save timestamps
setopt share_history          # share history between sessions

export EDITOR="zed --wait"
export VISUAL="zed --wait"
alias pip='pip3'

# User-level CLIs (claude, uv tools)
export PATH="$PATH:$HOME/.local/bin"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Private secrets (untracked; see ~/.zshenv.local)
[ -f "$HOME/.zshenv.local" ] && source "$HOME/.zshenv.local"

command -v starship >/dev/null && eval "$(starship init zsh)"

# Replaces cd with a frecency-aware version; `cdi` picks interactively.
# zoxide must be initialized last.
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"
